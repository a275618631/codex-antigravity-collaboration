{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub transport extension for the canonical Task Packet",
  "type": "object",
  "required": ["task_packet", "transport"],
  "properties": {
    "task_packet": {"type": "object", "required": ["task_id", "objective", "lane", "scope", "constraints", "validation_criteria"], "properties": {
      "task_id": {"type": "string"},
      "objective": {"type": "string"},
      "lane": {"type": "string"},
      "scope": {"type": "object"},
      "constraints": {"type": "array", "items": {"type": "string"}},
      "validation_criteria": {"type": "array", "items": {"type": "string"}},
      "origin_surface": {"type": "string", "enum": ["chatgpt_plus", "gemini_google_ai_pro", "manual"]},
      "client": {"type": "string", "enum": ["web", "mobile", "unspecified"]},
      "parent_task_id": {"type": ["string", "null"]},
      "revision": {"type": "integer", "minimum": 1}
    }},
    "transport": {"type": "object", "additionalProperties": false, "required": ["issue", "task_digest", "host", "approval_actor", "approval_nonce", "state"], "properties": {
      "issue": {"type": "integer"}, "task_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "host": {"type": "string"}, "approval_actor": {"type": "string"}, "approval_nonce": {"type": "string"},
      "state": {"enum": ["Draft", "Awaiting Approval", "Queued", "Running", "Validating", "Reporting", "Completed", "Failed", "Blocked", "Cancelled"]}
    }}
  }
}
